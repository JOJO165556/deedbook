# Modèle de secrets - copier en `.env` : cp .env.example .env
# Le .env n'est jamais commité ; les valeurs sont générées par `deedbook init`

# Connexion à la base du moteur (admin : migrations, rôles, administration)
DEEDBOOK_DATABASE_URL=postgresql://deedbook_admin:CHANGE_ME@localhost:5434/deedbook

# Connexions restreintes générées par `deedbook init` (affichées une seule fois)
# DEEDBOOK_INGEST_URL=   # rôle deedbook_ingest : INSERT seul sur les tables d'audit
# DEEDBOOK_READ_URL=    # rôle deedbook_read : SELECT seul

# Identifiants du conteneur PostgreSQL (docker compose)
DEEDBOOK_DB_USER=deedbook_admin
DEEDBOOK_DB_PASSWORD=CHANGE_ME
DEEDBOOK_DB_NAME=deedbook
DEEDBOOK_DB_PORT=5434

# Clé de signature des lots (Ed25519, base64) - générée par `deedbook init`
DEEDBOOK_SIGNING_KEY=

# Clé HMAC des empreintes d'événements - générée par `deedbook init`
DEEDBOOK_HMAC_KEY=

# Jeton d'administration (API + CLI) - généré par `deedbook init`
DEEDBOOK_ADMIN_TOKEN=

# Destination d'ancrage externe des empreintes (optionnel pour l'instant)
# DEEDBOOK_ANCHOR_URL=

# Port d'écoute du moteur
# DEEDBOOK_PORT=8000
